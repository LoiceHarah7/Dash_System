#python cache 
__pycache__/
*.py[cod]

#virtual environment
.venv/
venv/

#environment variables
.env
.env.*

#IDE settings
.vscode/

#flask instance folder - keep the directory tracked, ignore only the database files (they contain research data)
instance/*.db
instance/*.db-shm
instance/*.db-wal
# keep the directory itself tracked via .gitkeep
!instance/.gitkeep

#operating system files
.DS_Store
Thumbs.db

# Uploaded study local storage folders
saved_studies/*
!saved_studies/.gitkeep
saved_studies/**/
merged/
*.xlsx
*.xls
